# Зразок бойового .env. Скопіюйте на сервері як .env і заповніть значення.
# Файл .env у репозиторій НЕ потрапляє — він створюється лише на сервері.

APP_NAME="Шкільне харчування"
APP_ENV=production

# Згенерувати на сервері: php artisan key:generate
APP_KEY=

# КРИТИЧНО: на бойовому сервері має бути false.
# З true будь-яка помилка покаже стороннім вміст цього файлу, включно з паролем бази.
APP_DEBUG=false

APP_URL=https://food.zp.ua

# Публічна папка поза проєктом.
# Потрібно лише там, де document root змінити не можна — тоді код лежить
# у ~/school-food, а домен дивиться в ~/public_html.
# Якщо document root вказує всередину проєкту — лишіть порожнім.
APP_PUBLIC_PATH=/home/h78693c/public_html

APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_FAKER_LOCALE=uk_UA
APP_TIMEZONE=Europe/Kyiv

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- База даних ---
# Значення видає панель хостингу під час створення бази.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Пошта ---
# ТЗ забороняє mail() — потрібен саме SMTP.
# Дані видає хостинг або поштовий сервіс школи.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="harchuvannya@school.ua"
MAIL_FROM_NAME="${APP_NAME}"

# --- Telegram ---
# Токен видає @BotFather.
#
# Секрет вебхука: щонайменше 16 символів, ТІЛЬКИ латиниця, цифри, дефіс
# і підкреслення. Спецсимволи на кшталт «!» кодуються в адресі й ламають
# перевірку — бот мовчки перестає відповідати.
# Згенерувати придатний: php -r "echo bin2hex(random_bytes(24));"
#
# Без цих значень бот просто не працює, решта системи — так.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Обслуговування без SSH ---
# Потрібне лише на хостингу без shell-доступу.
# Згенерувати: php -r "echo bin2hex(random_bytes(24));"
#
# MAINTENANCE_TOKEN відкриває запуск міграцій через браузер — після
# запуску сайту цей рядок треба прибрати, тоді маршрут зникає.
# SCHEDULER_TOKEN потрібен постійно, якщо cron уміє лише відкривати URL.
MAINTENANCE_TOKEN=
SCHEDULER_TOKEN=

VITE_APP_NAME="${APP_NAME}"
